# ─────────────────────────────────────────────────────────────
# Heritage By Nancy — environment variables
# Copy to .env.local and fill in. NEVER commit real secrets.
# .env* is gitignored. Only NEXT_PUBLIC_* values reach the browser.
# ─────────────────────────────────────────────────────────────

# MongoDB connection string.
#   Local development : mongodb://127.0.0.1:27017/heritagebynancy
#   Production (Atlas): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/heritagebynancy?retryWrites=true&w=majority
MONGODB_URI=

# Secret used to sign admin session tokens (HS256, min 32 chars).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Canonical public site URL used for absolute metadata / sitemap / OG links.
# NEXT_PUBLIC_SITE_URL is still accepted as a fallback for older setups.
APP_SITE_URL=https://your-domain.com

# Bootstrap credentials for the FIRST admin account only (used by `npm run seed`
# when no admin exists, or by `npm run create-admin`). Not read at runtime.
# Use a strong password — min 10 chars with letters and numbers.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Store Admin

# Cloudinary (optional but required for admin image uploads).
# Get these from https://cloudinary.com/console — free tier is fine.
# Without them the admin can still paste image URLs manually.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
